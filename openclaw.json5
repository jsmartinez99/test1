// Configuración de modelos para OpenClaw vía OpenRouter.
// Copiar el bloque "agents" a ~/.openclaw/openclaw.json (formato JSON5).
// Credencial: en un chat privado enviar `/login openrouter`, o definir OPENROUTER_API_KEY.
// IDs y precios: catálogo de OpenRouter del 2026-10-05 (USD por millón de tokens, entrada/salida).
{
  agents: {
    defaults: {
      models: {
        "openrouter/z-ai/glm-5.3-flash": { alias: "glm" },
        "openrouter/qwen/qwen3.8-max-0902": { alias: "max" },
        "openrouter/qwen/qwen3.8-27b:free": { alias: "gratis" },
      },

      // Cadena principal: barato y fuerte -> más fuerte -> gratis.
      model: {
        primary: "openrouter/z-ai/glm-5.3-flash", // $0.15 / $0.50, agentic 50.9
        fallbacks: [
          "openrouter/qwen/qwen3.8-max-0902", // $2 / $6, agentic 56
          "openrouter/qwen/qwen3.8-27b:free", // $0 / $0, agentic 45.8
        ],
      },

      // Títulos, resúmenes de actividad y narración de progreso.
      utilityModel: "openrouter/google/gemma-4-31b-it:free", // $0 / $0

      // Se usa cuando el modelo de la sesión no acepta imágenes.
      imageModel: {
        primary: "openrouter/qwen/qwen3.8-27b:free",
        fallbacks: [
          "openrouter/google/gemma-4-31b-it:free",
          "openrouter/z-ai/glm-5.3-flash",
        ],
      },
    },
  },
}
